<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.shop.mapper.UserMapper">

    <!-- 根据用户名查询用户 -->
    <select id="selectByUsername" resultType="com.example.shop.entity.User">
        SELECT * FROM user WHERE username = #{username}
    </select>

    <!-- 根据手机号查询用户 -->
    <select id="selectByPhone" resultType="com.example.shop.entity.User">
        SELECT * FROM user WHERE phone = #{phone}
    </select>

    <!-- 分页查询用户列表 -->
    <select id="selectUserPage" resultType="com.example.shop.entity.User">
        SELECT * FROM user
        <where>
            <if test="username != null and username != ''">
                AND (username LIKE CONCAT('%', #{username}, '%') OR phone LIKE CONCAT('%', #{username}, '%'))
            </if>
            <if test="roleId != null">
                AND role_id = #{roleId}
            </if>
        </where>
        ORDER BY created_at DESC
    </select>

    <!-- 更新用户最后登录时间 -->
    <update id="updateLastLoginTime">
        UPDATE user SET last_login_time = NOW() WHERE user_id = #{userId}
    </update>

    <!-- 获取所有活跃用户ID列表 -->
    <select id="selectAllActiveUserIds" resultType="java.lang.Long">
        SELECT user_id FROM user WHERE status = 1
    </select>

</mapper>
